# Server
RETOAI_PORT=8000
CLIENT_URL=http://localhost:5173

# Dev only: mints Firebase ID tokens via /dev/token. Never enable in production.
ENABLE_DEV_AUTH=false
FIREBASE_WEB_API_KEY=

# Google Gemini API key (free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Logging (stdout/stderr; the hosting platform collects them)
LOG_LEVEL=INFO
LOG_FILE=

# MongoDB (share the same DB as the RTEX backend)
MONGODB_URL=

# Firebase service account (same as backend)
FIREBASE_TYPE=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_CERT_URL=
FIREBASE_CLIENT_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=
